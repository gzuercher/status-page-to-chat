{
  "openapi": "3.1.0",
  "info": {
    "title": "status-page-to-chat",
    "version": "1.1.0",
    "description": "Manage the providers monitored by status-page-to-chat and inspect runtime state. Designed for chat-based maintenance via Langdock or any OpenAPI-aware LLM tool."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Provider": {
        "type": "object",
        "required": ["key", "displayName", "adapter"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique identifier, lowercase ASCII letters, digits and hyphens only."
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280,
            "description": "Optional one-line service blurb shown on the chat card. Author it in the configured language; it is shown verbatim."
          },
          "adapter": {
            "type": "string",
            "enum": [
              "atlassian-statuspage",
              "google-workspace",
              "wedos-status-online",
              "github-issues",
              "betterstack-feed",
              "hund-atom",
              "zendesk-ssp",
              "html-scrape"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Required for atlassian-statuspage, wedos-status-online, betterstack-feed, hund-atom, zendesk-ssp and html-scrape."
          },
          "owner": {
            "type": "string",
            "description": "Required for github-issues."
          },
          "repo": {
            "type": "string",
            "description": "Required for github-issues."
          },
          "componentFilter": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Narrows the provider to specific components/services. Case-insensitive substring match, OR logic. A single comma-separated string is split on commas. Supported by atlassian-statuspage and zendesk-ssp. An entry may also name a component GROUP, which matches all of its members. A filter that stops matching (component renamed upstream) silences the provider — verify names against <baseUrl>/api/v2/components.json."
          },
          "minImpact": {
            "type": "string",
            "enum": ["none", "minor", "major", "critical"],
            "description": "Lowest incident severity that still produces a card; 'major' suppresses 'minor' and 'none'. atlassian-statuspage only — no other status page publishes a severity. Omit to inherit the deployment-wide default. Incidents with a missing or unrecognised impact are always reported."
          },
          "userAgent": {
            "type": "string"
          },
          "selector": {
            "type": "string",
            "description": "CSS selector, required for html-scrape. Points at the element whose text (or class attribute, when the text is empty) reflects the overall status."
          },
          "healthyMatch": {
            "type": "string",
            "description": "Required for html-scrape. Pattern meaning \"no incident\"; a string in /pattern/flags form is treated as a regex, everything else as a case-insensitive substring match."
          },
          "titleTemplate": {
            "type": "string",
            "description": "Optional, html-scrape only. {matchedText} is replaced with the scraped status text. Defaults to \"Status page reports: {matchedText}\"."
          },
          "logoUrl": {
            "type": "string",
            "format": "uri",
            "description": "Optional brand logo for the card. Without it the favicon of the baseUrl host is used; providers without a baseUrl render without a logo unless this is set. Legacy www.google.com/s2/favicons values are upgraded automatically."
          }
        }
      },
      "Incident": {
        "type": "object",
        "required": [
          "providerKey",
          "externalId",
          "title",
          "status",
          "url",
          "startedAt",
          "updatedAt"
        ],
        "properties": {
          "providerKey": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RunSummary": {
        "type": "object",
        "properties": {
          "providersTotal": {
            "type": "integer"
          },
          "providersSucceeded": {
            "type": "integer"
          },
          "providersFailed": {
            "type": "integer"
          },
          "incidentsOpen": {
            "type": "integer"
          },
          "incidentsResolved": {
            "type": "integer"
          },
          "notificationsSent": {
            "type": "integer"
          },
          "notificationsFailed": {
            "type": "integer"
          },
          "incidentsClosedStale": {
            "type": "integer",
            "description": "Incidents retired silently because the upstream stopped updating them for 14 days. Normally 0; a persistently non-zero value means a provider routinely leaves incidents open."
          },
          "durationMs": {
            "type": "integer"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "lastRunAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/providers": {
      "get": {
        "summary": "List monitored providers",
        "responses": {
          "200": {
            "description": "Current provider list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Provider"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/{key}": {
      "parameters": [
        {
          "name": "key",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get a single provider",
        "responses": {
          "200": {
            "description": "Provider entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provider"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Add or update a provider",
        "description": "If the key already exists, the entry is replaced in place. If it is new, the entry is appended. The full configuration is re-validated before the file is written.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Provider"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provider"
                }
              }
            }
          },
          "201": {
            "description": "Provider created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provider"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove a provider",
        "responses": {
          "204": {
            "description": "Removed"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/providers/validate": {
      "post": {
        "summary": "Validate a provider payload without saving",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Provider"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payload is valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents/open": {
      "get": {
        "summary": "List currently open incidents",
        "responses": {
          "200": {
            "description": "Open incidents across all providers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Incident"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/last-run": {
      "get": {
        "summary": "Summary of the most recent poll cycle",
        "responses": {
          "200": {
            "description": "Run summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "404": {
            "description": "No poll has completed yet"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI specification",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document"
          }
        }
      }
    }
  }
}
