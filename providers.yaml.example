# status-page-to-chat — provider configuration.
#
# This file lives next to docker-compose.yml on the host and is mounted
# into the container at /data/providers.yaml. Edit it directly: the next
# poll cycle (every 5 min) picks up your changes — no restart needed.
#
# Before first start: copy this file to providers.yaml and remove the
# entries you don't need.
#
#   cp providers.yaml.example providers.yaml
#
# Schema and adapter docs: docs/CONFIGURATION.md, docs/ADAPTERS.md.

chatTarget: googleChat        # or "teams"

providers:
  # --- Atlassian Statuspage ---
  # The most common status page format. baseUrl is the public status URL.
  - key: bitbucket
    displayName: Bitbucket
    adapter: atlassian-statuspage
    baseUrl: https://bitbucket.status.atlassian.com

  - key: bitwarden
    displayName: Bitwarden
    adapter: atlassian-statuspage
    baseUrl: https://status.bitwarden.com

  - key: webflow
    displayName: Webflow
    adapter: atlassian-statuspage
    baseUrl: https://status.webflow.com

  - key: figma
    displayName: Figma
    adapter: atlassian-statuspage
    baseUrl: https://status.figma.com

  # componentFilter limits notifications to specific components.
  # Single string or list of strings — substring match against the
  # component name (case-sensitive).
  - key: claude
    displayName: Claude
    adapter: atlassian-statuspage
    baseUrl: https://status.claude.com
    componentFilter:
      - claude.ai
      - Claude Code
      - api.anthropic.com

  # --- Google Workspace ---
  - key: google-workspace
    displayName: Google Workspace
    adapter: google-workspace

  # --- Metanet (Swiss hosting provider, RSS-based) ---
  - key: metanet
    displayName: Metanet
    adapter: metanet-rss

  # --- WEDOS (hosting provider, custom JSON) ---
  - key: wedos
    displayName: WEDOS
    adapter: wedos-status-online
    baseUrl: https://wedos.status.online

  # --- GitHub Issues as a status tracker ---
  # For projects that publish incidents as issues in a "status" repo.
  - key: onetimesecret
    displayName: Onetime Secret
    adapter: github-issues
    owner: onetimesecret
    repo: status
