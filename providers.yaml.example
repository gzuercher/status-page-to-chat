# status-page-to-chat — provider configuration.
#
# This file lives inside the container at /data/providers.yaml. On first
# start the container seeds it from this template, so `docker compose
# up -d` works with no host-side setup. The default is empty — the
# service polls nothing until you add entries. Two ways to add them:
#
#   - call PUT /api/providers/<key> on the management API (e.g. via a
#     chat-driven LLM assistant — see docs/LLM-INTEGRATION.md); or
#   - `docker compose cp status-poller:/data/providers.yaml ./providers.yaml`,
#     edit on the host, `docker compose cp` back. Next poll cycle
#     (within 5 min) picks it up automatically.
#
# Schema and adapter docs: docs/CONFIGURATION.md, docs/ADAPTERS.md.

chatTarget: googleChat        # "teams" (renders the card) or "teamsJson" (posts raw JSON)

# UI language for the chat cards and target language for machine-translated
# incident titles (Teams). "de" (default) | "en". Title translation also
# requires the ANTHROPIC_API_KEY env var; see docs/CONFIGURATION.md.
language: de

providers: []

# --- Example entries (uncomment and adapt) ----------------------------
#
# Atlassian Statuspage (most common format):
#
# providers:
#   - key: bitbucket
#     displayName: Bitbucket
#     description: Git-Hosting und CI/CD von Atlassian.   # optional, shown on the card
#     adapter: atlassian-statuspage
#     baseUrl: https://bitbucket.status.atlassian.com
#
#   - key: figma
#     displayName: Figma
#     adapter: atlassian-statuspage
#     baseUrl: https://status.figma.com
#
# Google Workspace:
#
#   - key: google-workspace
#     displayName: Google Workspace
#     adapter: google-workspace
#
# GitHub Issues as a status tracker:
#
#   - key: onetimesecret
#     displayName: Onetime Secret
#     adapter: github-issues
#     owner: onetimesecret
#     repo: status
#
# componentFilter narrows a status page to specific products/services.
# Substring match against component names, case-INsensitive, OR logic.
# A YAML list is the clearest form:
#
#   - key: claude
#     displayName: Claude
#     adapter: atlassian-statuspage
#     baseUrl: https://status.claude.com
#     componentFilter:
#       - claude.ai
#       - api.anthropic.com
#
# A single comma-separated string is also accepted and split on commas,
# so `componentFilter: claude.ai, Claude Code` is equivalent to the list
# above. Prefer the list — it cannot be misread.
#
# Beware: providers DO rename their components, and a filter that stops
# matching makes a provider go permanently silent. The adapter logs a
# warning ("componentFilter matched none of the upstream incidents")
# every cycle in that case, and a half-dead card follows after 7 days.
# Verify names against <baseUrl>/api/v2/components.json.
#
# logoUrl overrides the auto-derived brand logo (favicon of the baseUrl
# host). Use it when the status host's icon is not the brand's — e.g.
# wedos.status.online serves the status platform's checkmark, not the
# WEDOS logo — or for adapters without a baseUrl (github-issues).
#
# Any URL works; it is fetched by the chat client, so it must resolve
# without a redirect. Legacy www.google.com/s2/favicons values are
# rewritten automatically. See docs/CONFIGURATION.md → Brand logos.
#
#   - key: wedos
#     displayName: WEDOS
#     adapter: wedos-status-online
#     baseUrl: https://wedos.status.online
#     logoUrl: https://t0.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE%2CSIZE%2CURL&size=64&url=https%3A%2F%2Fwedos.cz
#
#   - key: onetimesecret
#     displayName: Onetime Secret
#     adapter: github-issues
#     owner: onetimesecret
#     repo: status
#     logoUrl: https://t0.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE%2CSIZE%2CURL&size=64&url=https%3A%2F%2Fonetimesecret.com
#
# html-scrape is a generic adapter for status pages without any JSON or
# feed endpoint. It fetches the HTML, runs a CSS selector and treats the
# element's text (or class attribute, if empty) as the overall status.
# Anything that does not match healthyMatch becomes a synthetic open
# incident. See docs/ADAPTERS.md → html-scrape for details and caveats.
#
#   - key: checkcentral
#     displayName: CheckCentral
#     adapter: html-scrape
#     baseUrl: https://status.checkcentral.cc
#     selector: ".StatusDot > div"
#     healthyMatch: success
