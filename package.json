{
  "name": "status-page-to-chat",
  "version": "0.6.0",
  "description": "Self-hosted poller that watches external status pages and posts incidents to Microsoft Teams",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ && prettier --check src/ tests/",
    "format": "prettier --write src/ tests/",
    "start": "node dist/src/main.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "fast-xml-parser": "^5.10.1",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "undici": "^8.10.2",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "license": "MIT"
}
